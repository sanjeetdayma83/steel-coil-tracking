  Widget build(BuildContext context) {
    return LayoutBuilder(
      builder: (context, constraints) {
        final padding = constraints.maxWidth >= 700 ? 28.0 : 16.0;
        return SingleChildScrollView(
          padding: EdgeInsets.fromLTRB(padding, 20, padding, 32),
          child: Center(
            child: ConstrainedBox(
              constraints: const BoxConstraints(maxWidth: 1150),
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  const Text('Check Location', style: AppTextStyles.pageTitle),
                  const SizedBox(height: 8),
                  const Text(
                    'Search a Coil No. live, or select a PPC machine to inspect its current plan.',
                    style: AppTextStyles.pageSubtitle,
                  ),
                  const SizedBox(height: 20),
                  Card(
                    child: Padding(
                      padding: const EdgeInsets.all(18),
                      child: LayoutBuilder(
                        builder: (context, inner) {
                          final controls = <Widget>[
                            Expanded(child: _machineDropdown()),
                            Expanded(child: _coilSearchField()),
                          ];
                          if (inner.maxWidth < 720) {
                            return Column(
                              children: [
                                _machineDropdown(),
                                const SizedBox(height: 12),
                                _coilSearchField(),
                              ],
                            );
                          }
                          return Row(
                            children: [
                              controls[0],
                              const SizedBox(width: 12),
                              controls[1],
                            ],
                          );
                        },
                      ),
                    ),
                  ),
                  if (_error != null) ...[
                    const SizedBox(height: 12),
                    Text(
                      _error!,
                      style: const TextStyle(color: AppColors.danger),
                    ),
                  ],
                  if (_searchController.text.trim().isNotEmpty) ...[
                    const SizedBox(height: 12),
                    _searchResultsCard(),
                  ],
                  if (_selectedCoil != null) ...[
                    const SizedBox(height: 12),
                    _selectedCoilCard(_selectedCoil!),
                  ],
                  const SizedBox(height: 16),
                  _machinePlanCard(),
                  const SizedBox(height: 16),
                  _recentScannedCard(),
                ],
              ),
            ),
          ),
        );
      },
    );
  }

  Widget _machineDropdown() {
    return DropdownButtonFormField<String>(
      initialValue: _selectedMachine,
      isExpanded: true,
      decoration: const InputDecoration(
        labelText: 'PPC Machine',
        prefixIcon: Icon(Icons.precision_manufacturing_rounded),
      ),
      items: [
        const DropdownMenuItem<String>(
          value: '__ALL__',
          child: Text('ALL PLAN', overflow: TextOverflow.ellipsis),
        ),
        for (final machine in _machines)
          DropdownMenuItem<String>(
            value: machine['code'] as String,
            child: Text('${machine['code']}', overflow: TextOverflow.ellipsis),
          ),
      ],
      onChanged: _loadPlanForMachine,
    );
  }

  Widget _coilSearchField() {
    return TextField(
      controller: _searchController,
      textInputAction: TextInputAction.search,
      onChanged: _onSearchChanged,
      decoration: InputDecoration(
        labelText: 'Search Coil No. live',
        hintText: _selectedMachine == null
            ? 'Type any part of Coil No.'
            : 'Search coils on $_selectedMachine',
        prefixIcon: const Icon(Icons.search_rounded),
        suffixIcon: _searchController.text.isEmpty
            ? null
            : IconButton(
                onPressed: () {
                  _searchController.clear();
                  _onSearchChanged('');
                },
                icon: const Icon(Icons.clear),
              ),
      ),
    );
  }

  Widget _searchResultsCard() {
    return Card(
      child: Padding(
        padding: const EdgeInsets.all(16),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Row(
              children: [
                const Expanded(
                  child: Text(
                    'Matching coils',
                    style: AppTextStyles.sectionTitle,
                  ),
                ),
                if (_searching)
                  const SizedBox(
                    width: 18,
                    height: 18,
                    child: CircularProgressIndicator(strokeWidth: 2),
                  ),
                if (!_searching)
                  Text(
                    '${_applyLocationFilter(_searchResults).length}',
                    style: AppTextStyles.cardLabel,
                  ),
              ],
            ),
            const SizedBox(height: 10),
            Wrap(
              spacing: 8,
              runSpacing: 8,
              children: [
                ChoiceChip(
                  label: const Text('All'),
                  selected: _locationFilter == 'all',
                  onSelected: (_) => setState(() => _locationFilter = 'all'),
                ),
                ChoiceChip(
                  label: const Text('Located'),
                  selected: _locationFilter == 'located',
                  onSelected: (_) =>
                      setState(() => _locationFilter = 'located'),
                ),
                ChoiceChip(
                  label: const Text('Not located'),
                  selected: _locationFilter == 'not_located',
                  onSelected: (_) =>
                      setState(() => _locationFilter = 'not_located'),
                ),
              ],
            ),
            const SizedBox(height: 10),
            if (_searching)
              const Padding(
                padding: EdgeInsets.symmetric(vertical: 18),
                child: Center(child: Text('Searching...')),
              )
            else if (_applyLocationFilter(_searchResults).isEmpty)
              const Padding(
                padding: EdgeInsets.symmetric(vertical: 18),
                child: Text('No Coil No. found.'),
              )
            else
              ..._applyLocationFilter(_searchResults).map(_searchResultTile),
          ],
        ),
      ),
    );
  }

  Widget _searchResultTile(Map<String, dynamic> coil) {
    final scanned = coil['has_location'] == true;
    final plannedMachines =
        (coil['planned_machines'] as List?)?.map((e) => '$e').toList() ??
        const <String>[];
    return InkWell(
      onTap: () => _selectSearchResult(coil),
      child: Container(
        width: double.infinity,
        margin: const EdgeInsets.only(bottom: 8),
        padding: const EdgeInsets.all(12),
        decoration: BoxDecoration(
          color: AppColors.surfaceSoft,
          borderRadius: BorderRadius.circular(12),
        ),
        child: Row(
          children: [
            Icon(
              scanned ? Icons.location_on_rounded : Icons.qr_code_rounded,
              color: scanned ? AppColors.success : AppColors.textSecondary,
            ),
            const SizedBox(width: 10),
            Expanded(
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Text(
                    '${coil['coil_no']}',
                    maxLines: 1,
                    overflow: TextOverflow.ellipsis,
                    style: const TextStyle(fontWeight: FontWeight.w700),
                  ),
                  const SizedBox(height: 3),
                  Text(
                    'T ${coil['thickness'] ?? '-'} × W ${coil['width'] ?? '-'}',
                    style: AppTextStyles.cardLabel,
                  ),
                  Text(
                    plannedMachines.isEmpty
                        ? 'Not planned in active PPC'
                        : 'Planned: ${plannedMachines.join(', ')}',
                    maxLines: 2,
                    overflow: TextOverflow.ellipsis,
                    style: TextStyle(
                      color: plannedMachines.isEmpty
                          ? AppColors.textSecondary
                          : AppColors.success,
                      fontSize: 12,
                      fontWeight: FontWeight.w600,
                    ),
                  ),
                  const SizedBox(height: 2),
                  Text(
                    scanned
                        ? '${coil['location_name'] ?? '-'} • ${coil['line_name'] ?? '-'}'
                        : 'Not scanned yet',
                    maxLines: 1,
                    overflow: TextOverflow.ellipsis,
                    style: AppTextStyles.cardLabel,
                  ),
                ],
              ),
            ),
            const Icon(Icons.chevron_right_rounded),
          ],
        ),
      ),
    );
  }

  Widget _selectedCoilCard(Map<String, dynamic> coil) {
    return Card(
      child: ListTile(
        leading: const Icon(Icons.verified_rounded, color: AppColors.success),
        title: Text(
          '${coil['coil_no']}',
          maxLines: 1,
          overflow: TextOverflow.ellipsis,
        ),
        subtitle: Text(
          'T ${coil['thickness'] ?? '-'} × W ${coil['width'] ?? '-'} • '
          '${coil['has_location'] == true ? '${coil['location_name']} / ${coil['line_name']}' : 'Not scanned yet'}',
          maxLines: 2,
          overflow: TextOverflow.ellipsis,
        ),
        trailing: const Icon(Icons.info_outline_rounded),
        onTap: () => _showCoilDetails(coil),
      ),
    );
  }

  Widget _machinePlanCard() {
    // location filter applies to plan list too
    if (_selectedMachine == null) {
      return Card(
        child: Padding(
          padding: const EdgeInsets.all(28),
          child: Column(
            children: const [
              Icon(Icons.precision_manufacturing_outlined, size: 46),
              SizedBox(height: 12),
              Text('Select a PPC machine', style: AppTextStyles.sectionTitle),
              SizedBox(height: 6),
              Text(
                'Its latest active PPC plan rows will appear here.',
                textAlign: TextAlign.center,
                style: AppTextStyles.pageSubtitle,
              ),
            ],
          ),
        ),
      );
    }

    if (_loading) {
      return const Card(
        child: Padding(
          padding: EdgeInsets.all(40),
          child: Center(child: CircularProgressIndicator()),
        ),
      );
    }

    return Card(
      child: Padding(
        padding: const EdgeInsets.all(20),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Row(
              children: [
                Expanded(
                  child: Text(
                    'PPC Plan • $_selectedMachine',
                    style: AppTextStyles.sectionTitle,
                  ),
                ),
                Text(
                  '${_applyLocationFilter(_planRows).length} coils',
                  style: AppTextStyles.cardLabel,
                ),
              ],
            ),
            const SizedBox(height: 12),

            // ------------------------------------------------
            // LOCATION STATUS FILTER
            // Located / Not Located / All
            // Applied directly to the PPC plan list.
            // ------------------------------------------------
            _locationFilterChips(_planRows),

            const SizedBox(height: 12),

            Builder(
              builder: (context) {
                final filteredRows = _applyLocationFilter(_planRows);

                if (filteredRows.isEmpty) {
                  return Text(
                    _locationFilter == 'located'
                        ? 'No located coils found in this PPC plan.'
                        : _locationFilter == 'not_located'
                        ? 'All coils in this PPC plan are located.'
                        : 'No physical coils found in this active PPC plan.',
                    style: AppTextStyles.pageSubtitle,
                  );
                }

                return Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    ...filteredRows.take(100).map(_planRow),

                    if (filteredRows.length > 100)
                      const Padding(
                        padding: EdgeInsets.only(top: 8),
                        child: Text(
                          'Showing the first 100 physical coils in test mode.',
                          style: AppTextStyles.cardLabel,
                        ),
                      ),
                  ],
                );
              },
            ),
          ],
        ),
      ),
    );
  }

  Widget _planRow(Map<String, dynamic> row) {
    final physical = '${row['physical_coil_no'] ?? row['coil_no'] ?? '-'}';

    final machine = '${row['planned_machine_code'] ?? '-'}';

    return Container(
      width: double.infinity,
      margin: const EdgeInsets.only(bottom: 8),
      padding: const EdgeInsets.all(14),
      decoration: BoxDecoration(
        color: AppColors.surfaceSoft,
        borderRadius: BorderRadius.circular(12),
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          Text(
            physical,
            maxLines: 1,
            overflow: TextOverflow.ellipsis,
            style: const TextStyle(fontWeight: FontWeight.w800, fontSize: 16),
          ),
          const SizedBox(height: 5),
          Text(
            'Planned: $machine',
            style: const TextStyle(fontWeight: FontWeight.w700),
          ),
          const SizedBox(height: 4),
          Wrap(
            spacing: 12,
            runSpacing: 6,
            children: [
              Text(
                'T ${row['input_thickness'] ?? '-'}',
                style: AppTextStyles.cardLabel,
              ),
              Text(
                'W ${row['input_width'] ?? '-'}',
                style: AppTextStyles.cardLabel,
              ),
              Text(
                'Mother ${row['mother_coil'] ?? '-'}',
                style: AppTextStyles.cardLabel,
              ),
              Text(
                'Slit ${row['slit_id'] ?? '-'}',
                style: AppTextStyles.cardLabel,
              ),
            ],
          ),
        ],
      ),
    );
  }

  Widget _recentScannedCard() {
    return Card(
      child: Padding(
        padding: const EdgeInsets.all(20),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Row(
              children: [
                const Expanded(
                  child: Text(
                    'Latest Verified Coil Locations',
                    style: AppTextStyles.sectionTitle,
                  ),
                ),
                IconButton(
                  tooltip: 'Refresh',
                  onPressed: _loadRecentLocations,
                  icon: const Icon(Icons.refresh_rounded),
                ),
              ],
            ),
            const SizedBox(height: 8),
            if (_recentLocations.isEmpty)
              const Text(
                'No scanned coil locations available yet.',
                style: AppTextStyles.pageSubtitle,
              )
            else
              ..._recentLocations.map(
                (coil) => InkWell(
                  onTap: () =>
                      _showCoilDetails({...coil, 'has_location': true}),
                  child: Padding(
                    padding: const EdgeInsets.symmetric(vertical: 8),
                    child: Row(
                      children: [
                        const Icon(
                          Icons.qr_code_rounded,
                          color: AppColors.navy,
                          size: 20,
                        ),
                        const SizedBox(width: 10),
                        Expanded(
                          child: Column(
                            crossAxisAlignment: CrossAxisAlignment.start,
                            children: [
                              Text(
                                '${coil['coil_no']}',
                                maxLines: 1,
                                overflow: TextOverflow.ellipsis,
                                style: const TextStyle(
                                  fontWeight: FontWeight.w700,
                                ),
                              ),
                              Text(
                                '${coil['location_name']} • ${coil['line_name']}',
                                maxLines: 1,
                                overflow: TextOverflow.ellipsis,
                                style: AppTextStyles.cardLabel,
                              ),
                            ],
                          ),
                        ),
                        Text(
                          '#${coil['sequence_no']}',
                          style: AppTextStyles.cardLabel,
                        ),
                      ],
                    ),
                  ),
                ),
              ),
          ],
        ),
      ),
    );
  }
}
