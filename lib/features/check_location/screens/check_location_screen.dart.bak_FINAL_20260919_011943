import 'dart:async';

import 'package:flutter/material.dart';

import '../../../app/theme/app_colors.dart';
import '../../../app/theme/app_text_styles.dart';
import '../../../core/services/supabase_service.dart';

class CheckLocationScreen extends StatefulWidget {
  const CheckLocationScreen({super.key});

  @override
  State<CheckLocationScreen> createState() => _CheckLocationScreenState();
}

class _CheckLocationScreenState extends State<CheckLocationScreen> {
  final _searchController = TextEditingController();

  List<Map<String, dynamic>> _machines = const [];
  List<Map<String, dynamic>> _planRows = const [];
  List<Map<String, dynamic>> _recentLocations = const [];
  List<Map<String, dynamic>> _searchResults = const [];
  Map<String, dynamic>? _selectedCoil;

  String? _selectedMachine;
  String? _error;
  bool _loading = false;
  bool _searching = false;
  Timer? _searchDebounce;
  int _searchToken = 0;
  String _locationFilter = 'all'; // all | located | not_located

  @override
  void initState() {
    super.initState();
    _loadMachines();
    _loadRecentLocations();
    _loadPlanForMachine('__ALL__'); // ALL PLAN
  }

  @override
  void dispose() {
    _searchDebounce?.cancel();
    _searchController.dispose();
    super.dispose();
  }

  Future<void> _loadMachines() async {
    try {
      final rows = await SupabaseService.client
          .from('app_machines')
          .select('id,code,name')
          .eq('active', true)
          .order('code');

      if (!mounted) return;
      setState(() {
        _machines = List<Map<String, dynamic>>.from(rows);
      });
    } catch (error) {
      if (mounted) setState(() => _error = 'Machine list failed: $error');
    }
  }

  Future<void> _loadRecentLocations() async {
    try {
      final rows = await SupabaseService.client
          .from('v_current_coil_locations')
          .select()
          .order('scanned_at', ascending: false)
          .limit(50);

      if (!mounted) return;
      setState(() {
        _recentLocations = List<Map<String, dynamic>>.from(rows);
      });
    } catch (error) {
      if (mounted) setState(() => _error = 'Location data failed: $error');
    }
  }

  Future<void> _loadPlanForMachine(String? machineCode) async {
    if (!mounted) return;

    setState(() {
      _selectedMachine = machineCode;
      _locationFilter = 'all';
      _loading = machineCode != null;
      _error = null;
      _planRows = const [];
    });

    if (machineCode == null) {
      if (mounted) setState(() => _loading = false);
      return;
    }

    try {
      final db = SupabaseService.client;

      // IMPORTANT:
      // Always read the canonical active PPC view.
      // This view applies physical_coil_no(mother_coil, slit_id).
      final query = db
          .from('v_active_ppc_coils')
          .select(
            'plan_id,plan_row_id,planned_machine_code,'
            'previous_stage_code,input_thickness,input_width,'
            'mother_coil,slit_id,physical_coil_no',
          );

      final rows = machineCode == '__ALL__'
          ? await query.order('plan_row_id')
          : await query
                .eq('planned_machine_code', machineCode)
                .order('plan_row_id');

      // PPC rows remain untouched.
      // UI shows each physical Coil No only once.
      final uniqueRows = <String, Map<String, dynamic>>{};

      for (final raw in List<Map<String, dynamic>>.from(rows)) {
        final physical = '${raw['physical_coil_no'] ?? ''}'
            .trim()
            .toUpperCase();

        if (physical.isEmpty) continue;

        uniqueRows.putIfAbsent(physical, () => {...raw, 'coil_no': physical});
      }

      // Attach latest location for each plan physical coil
      final physicals = uniqueRows.keys.toList();
      final locRows = physicals.isEmpty
          ? const <dynamic>[]
          : await db
                .from('v_current_coil_locations')
                .select()
                .inFilter('coil_no', physicals);

      final locByCoil = <String, Map<String, dynamic>>{};
      for (final raw in List<Map<String, dynamic>>.from(locRows)) {
        final cn = '${raw['coil_no'] ?? ''}'.trim().toUpperCase();
        if (cn.isNotEmpty) locByCoil[cn] = raw;
      }

      final enriched = <Map<String, dynamic>>[];
      for (final row in uniqueRows.values) {
        final key = '${row['coil_no'] ?? ''}'.trim().toUpperCase();
        final loc = locByCoil[key];
        final machines = <String>{};
        final code = '${row['planned_machine_code'] ?? ''}'.trim();
        if (code.isNotEmpty) machines.add(code);
        // also smart-match for scanned-style numbers
        for (final m in await _plannedMachinesFor(key)) {
          machines.add(m);
        }
        enriched.add({
          ...row,
          ...?loc,
          'has_location': loc != null,
          'planned_machines': machines.toList()..sort(),
        });
      }

      enriched.sort((a, b) {
        final la = a['has_location'] == true ? 0 : 1;
        final lb = b['has_location'] == true ? 0 : 1;
        if (la != lb) return la.compareTo(lb);
        return '${a['coil_no']}'.compareTo('${b['coil_no']}');
      });

      if (!mounted) return;

      setState(() {
        _planRows = enriched;
        _loading = false;
      });
    } catch (error) {
      if (!mounted) return;

      setState(() {
        _loading = false;
        _error = 'PPC plan load failed: $error';
      });
    }
  }

  void _onSearchChanged(String value) {
    _searchDebounce?.cancel();
    final query = value.trim();

    if (query.isEmpty) {
      setState(() {
        _searchResults = const [];
        _selectedCoil = null;
        _searching = false;
        _error = null;
      });
      return;
    }

    setState(() {
      _searching = true;
      _error = null;
      _selectedCoil = null;
      _locationFilter = 'all';
    });

    final token = ++_searchToken;
    _searchDebounce = Timer(const Duration(milliseconds: 250), () {
      unawaited(_searchCoils(query, token));
    });
  }

  Future<List<String>> _plannedMachinesFor(String coilNo) async {
    final normalized = coilNo.trim().toUpperCase();
    if (normalized.isEmpty) return const [];
    try {
      final rows = await SupabaseService.client.rpc(
        'match_planned_machines',
        params: {'p_coil_no': normalized},
      );
      final codes = <String>{};
      for (final row in List<Map<String, dynamic>>.from(rows as List)) {
        final code = '${row['planned_machine_code'] ?? ''}'.trim();
        if (code.isNotEmpty) codes.add(code);
      }
      return codes.toList()..sort();
    } catch (e) {
      debugPrint('match_planned_machines failed: $e');
      return const [];
    }
  }

  List<Map<String, dynamic>> _applyLocationFilter(
    List<Map<String, dynamic>> rows,
  ) {
    if (_locationFilter == 'located') {
      return rows.where((e) => e['has_location'] == true).toList();
    }
    if (_locationFilter == 'not_located') {
      return rows.where((e) => e['has_location'] != true).toList();
    }
    return rows;
  }

  Widget _locationFilterChips(List<Map<String, dynamic>> rows) {
    final total = rows.length;
    final located = rows.where((e) => e['has_location'] == true).length;
    final notLocated = total - located;

    Widget chip({
      required String label,
      required int count,
      required String value,
      required IconData icon,
    }) {
      final selected = _locationFilter == value;

      return ChoiceChip(
        selected: selected,
        avatar: Icon(icon, size: 17),
        label: Text('$label $count'),
        onSelected: (_) {
          if (!mounted) return;
          setState(() => _locationFilter = value);
        },
      );
    }

    return Container(
      width: double.infinity,
      padding: const EdgeInsets.all(12),
      decoration: BoxDecoration(
        color: AppColors.surfaceSoft,
        borderRadius: BorderRadius.circular(12),
        border: Border.all(color: AppColors.border),
      ),
      child: Wrap(
        spacing: 8,
        runSpacing: 8,
        children: [
          chip(
            label: 'All',
            count: total,
            value: 'all',
            icon: Icons.view_list_rounded,
          ),
          chip(
            label: 'Located',
            count: located,
            value: 'located',
            icon: Icons.location_on_rounded,
          ),
          chip(
            label: 'Not Located',
            count: notLocated,
            value: 'not_located',
            icon: Icons.location_off_rounded,
          ),
        ],
      ),
    );
  }

  Future<void> _searchCoils(String query, int token) async {
    try {
      final db = SupabaseService.client;
      final needle = query.trim().toUpperCase();

      if (needle.isEmpty) return;

      // Search physical coil master.
      final coilRowsRaw = await db
          .from('coils')
          .select('id,coil_no,material_code,thickness,width')
          .ilike('coil_no', '%$needle%')
          .order('coil_no')
          .limit(50);

      // Search canonical ACTIVE PPC VIEW.
      // This is the same physical_coil_no logic used everywhere else.
      final ppcRowsRaw = await db
          .from('v_active_ppc_coils')
          .select(
            'plan_id,plan_row_id,planned_machine_code,'
            'previous_stage_code,input_thickness,input_width,'
            'mother_coil,slit_id,physical_coil_no',
          )
          .order('plan_row_id')
          .limit(1000);

      if (!mounted || token != _searchToken) return;

      final merged = <String, Map<String, dynamic>>{};
      final plannedMachines = <String, Set<String>>{};

      // Existing physical coil master.
      for (final raw in List<Map<String, dynamic>>.from(coilRowsRaw)) {
        final coilNo = '${raw['coil_no'] ?? ''}'.trim().toUpperCase();

        if (coilNo.isEmpty) continue;

        merged.putIfAbsent(coilNo, () => {...raw, 'coil_no': coilNo});
      }

      // Active PPC physical coils.
      for (final raw in List<Map<String, dynamic>>.from(ppcRowsRaw)) {
        final physicalNo = '${raw['physical_coil_no'] ?? ''}'
            .trim()
            .toUpperCase();

        if (physicalNo.isEmpty) continue;

        final mother = '${raw['mother_coil'] ?? ''}'.trim().toUpperCase();

        final slit = '${raw['slit_id'] ?? ''}'.trim().toUpperCase();

        // Live search should match:
        // physical Coil No, Mother Coil or Slit ID.
        final matches =
            physicalNo.contains(needle) ||
            mother.contains(needle) ||
            slit.contains(needle);

        if (!matches) continue;

        final existing = merged[physicalNo];

        if (existing == null) {
          merged[physicalNo] = {
            'id': null,
            'coil_no': physicalNo,
            'material_code': null,
            'thickness': raw['input_thickness'],
            'width': raw['input_width'],
            'has_location': false,
          };
        } else {
          if (existing['thickness'] == null) {
            existing['thickness'] = raw['input_thickness'];
          }

          if (existing['width'] == null) {
            existing['width'] = raw['input_width'];
          }
        }

        final machine = '${raw['planned_machine_code'] ?? ''}'.trim();

        if (machine.isNotEmpty) {
          (plannedMachines[physicalNo] ??= <String>{}).add(machine);
        }
      }

      final resultsBase = merged.values.toList()
        ..sort((a, b) => '${a['coil_no']}'.compareTo('${b['coil_no']}'));

      // Fetch latest actual location.
      final coilNos = resultsBase
          .map((row) => '${row['coil_no'] ?? ''}'.trim())
          .where((value) => value.isNotEmpty)
          .toList();

      final locations = coilNos.isEmpty
          ? const <dynamic>[]
          : await db
                .from('v_current_coil_locations')
                .select()
                .inFilter('coil_no', coilNos);

      final locationByCoil = <String, Map<String, dynamic>>{};

      for (final raw in List<Map<String, dynamic>>.from(locations)) {
        final coilNo = '${raw['coil_no'] ?? ''}'.trim().toUpperCase();

        if (coilNo.isNotEmpty) {
          locationByCoil[coilNo] = raw;
        }
      }

      final results = <Map<String, dynamic>>[];
      for (final coil in resultsBase) {
        final key = '${coil['coil_no'] ?? ''}'.trim().toUpperCase();
        final location = locationByCoil[key];

        // Exact map from PPC rows + smart RPC match (scanned vs plan form)
        final fromMap = (plannedMachines[key] ?? const <String>{}).toList()
          ..sort();
        final fromRpc = await _plannedMachinesFor(key);
        final mergedMachines = <String>{...fromMap, ...fromRpc}.toList()
          ..sort();

        results.add({
          ...coil,
          ...?location,
          'has_location': location != null,
          'planned_machines': mergedMachines,
        });
      }

      // Organize: located first, then planned, then coil no
      results.sort((a, b) {
        final la = a['has_location'] == true ? 0 : 1;
        final lb = b['has_location'] == true ? 0 : 1;
        if (la != lb) return la.compareTo(lb);
        final pa = ((a['planned_machines'] as List?)?.isNotEmpty ?? false)
            ? 0
            : 1;
        final pb = ((b['planned_machines'] as List?)?.isNotEmpty ?? false)
            ? 0
            : 1;
        if (pa != pb) return pa.compareTo(pb);
        return '${a['coil_no']}'.compareTo('${b['coil_no']}');
      });

      if (!mounted || token != _searchToken) return;

      setState(() {
        _searchResults = results;
        _searching = false;
        _error = null;
      });
    } catch (error) {
      if (!mounted || token != _searchToken) return;

      setState(() {
        _searchResults = const [];
        _searching = false;
        _error =
            'Unable to search coil. Please check your connection and try again.';
      });
    }
  }

  void _selectSearchResult(Map<String, dynamic> coil) {
    setState(() => _selectedCoil = coil);
    _showCoilDetails(coil);
  }

  void _showCoilDetails(Map<String, dynamic> coil) async {
    var plannedMachines = List<String>.from(
      (coil['planned_machines'] as List?) ?? const [],
    );
    // Always resolve via smart match (scanned form vs plan form)
    final rpcMachines = await _plannedMachinesFor('${coil['coil_no'] ?? ''}');
    if (rpcMachines.isNotEmpty) {
      plannedMachines = rpcMachines;
    }
    if (!mounted) return;
    showModalBottomSheet<void>(
      context: context,
      isScrollControlled: true,
      showDragHandle: true,
      builder: (context) {
        return SafeArea(
          child: Padding(
            padding: const EdgeInsets.fromLTRB(20, 6, 20, 28),
            child: SingleChildScrollView(
              child: Column(
                mainAxisSize: MainAxisSize.min,
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Row(
                    children: [
                      const Expanded(
                        child: Text(
                          'Coil Details & Last Location',
                          style: AppTextStyles.sectionTitle,
                        ),
                      ),
                      IconButton(
                        onPressed: () => Navigator.pop(context),
                        icon: const Icon(Icons.close),
                      ),
                    ],
                  ),
                  const SizedBox(height: 8),
                  _detail('Coil No', '${coil['coil_no'] ?? '-'}'),
                  _detail('Material Code', '${coil['material_code'] ?? '-'}'),
                  _detail('Thickness', '${coil['thickness'] ?? '-'}'),
                  _detail('Width', '${coil['width'] ?? '-'}'),
                  _detail(
                    'Planned Machine',
                    plannedMachines.isEmpty
                        ? 'NOT PLANNED'
                        : plannedMachines.join(', '),
                  ),
                  _detail(
                    'Location',
                    coil['has_location'] == true
                        ? '${coil['location_name'] ?? '-'}'
                        : 'Not scanned yet',
                  ),
                  _detail(
                    'Line',
                    coil['has_location'] == true
                        ? '${coil['line_name'] ?? '-'}'
                        : '-',
                  ),
                  _detail(
                    'Sequence',
                    coil['has_location'] == true
                        ? '${coil['sequence_no'] ?? '-'}'
                        : '-',
                  ),
                  _detail(
                    'Last Scan',
                    coil['has_location'] == true
                        ? '${coil['scanned_at'] ?? '-'}'
                        : '-',
                  ),
                  _detail(
                    'Operator',
                    coil['has_location'] == true
                        ? '${coil['operator_label'] ?? '-'}'
                        : '-',
                  ),
                ],
              ),
            ),
          ),
        );
      },
    );
  }

  Widget _detail(String label, String value) {
    return Padding(
      padding: const EdgeInsets.only(bottom: 10),
      child: Row(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          SizedBox(
            width: 120,
            child: Text(label, style: AppTextStyles.cardLabel),
          ),
          Expanded(
            child: Text(
              value,
              maxLines: 3,
              overflow: TextOverflow.ellipsis,
              style: const TextStyle(fontWeight: FontWeight.w600),
            ),
          ),
        ],
      ),
    );
  }

